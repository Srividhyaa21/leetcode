import java.util.concurrent.Semaphore;
import java.util.function.IntConsumer;

class FizzBuzz {
    private int n;
    
    // Semaphores to control execution order
    private Semaphore semNumber = new Semaphore(1); // Starts allowed for 'number'
    private Semaphore semFizz = new Semaphore(0);
    private Semaphore semBuzz = new Semaphore(0);
    private Semaphore semFizzBuzz = new Semaphore(0);

    public FizzBuzz(int n) {
        this.n = n;
    }

    // printFizz.run() outputs "fizz".
    public void fizz(Runnable printFizz) throws InterruptedException {
        for (int i = 3; i <= n; i += 3) {
            if (i % 5 != 0) { // Only multiples of 3 (and not 5)
                semFizz.acquire();
                printFizz.run();
                semNumber.release();
            }
        }
    }

    // printBuzz.run() outputs "buzz".
    public void buzz(Runnable printBuzz) throws InterruptedException {
        for (int i = 5; i <= n; i += 5) {
            if (i % 3 != 0) { // Only multiples of 5 (and not 3)
                semBuzz.acquire();
                printBuzz.run();
                semNumber.release();
            }
        }
    }

    // printFizzBuzz.run() outputs "fizzbuzz".
    public void fizzbuzz(Runnable printFizzBuzz) throws InterruptedException {
        for (int i = 15; i <= n; i += 15) { // Multiples of both 3 and 5
            semFizzBuzz.acquire();
            printFizzBuzz.run();
            semNumber.release();
        }
    }

    // printNumber.accept(x) outputs "x", where x is an integer.
    public void number(IntConsumer printNumber) throws InterruptedException {
        for (int i = 1; i <= n; i++) {
            semNumber.acquire();
            if (i % 3 == 0 && i % 5 == 0) {
                semFizzBuzz.release();
            } else if (i % 3 == 0) {
                semFizz.release();
            } else if (i % 5 == 0) {
                semBuzz.release();
            } else {
                printNumber.accept(i);
                semNumber.release();
            }
        }
    }
}
